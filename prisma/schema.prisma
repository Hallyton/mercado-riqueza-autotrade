// Mercado da Riqueza AutoTrade — schema alinhado a MERCADO_DA_RIQUEZA_AUTOTRADE_MASTER.md
// Vault de estratégia (strategy_configs) fica fora deste schema — DB/processo isolado na versão Pro.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  SUPPORT
  OPS
  FINANCE
  STRATEGY_OPS
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

enum LicenseStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  REVOKED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PENDING
  PAID
  OVERDUE
  CANCELLED
  VOID
  FAILED
  UNCOLLECTIBLE
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  PIX
  CARD
  BOLETO
  MANUAL
  UNKNOWN
}

enum BillingProvider {
  MANUAL
  MOCK
  ASAAS
  MERCADO_PAGO
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InstructionSide {
  BUY
  SELL
}

enum InstructionOrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
}

enum InstructionPurpose {
  ENTRY
  EXIT
  ADJUSTMENT
}

/**
 * Origem da instrução — fila admin / dispatch do sinal mestre (não exposta ao cliente).
 */
enum InstructionSource {
  TEST
  HOMOLOGATION
  MASTER_SIGNAL
  REAL_MANUAL
  AUTONOMOUS_STRATEGY
}

/**
 * Sinal mestre (EA Mãe) — ciclo de vida na plataforma.
 */
enum MasterSignalStatus {
  RECEIVED
  VALIDATED
  REJECTED
  DISPATCHING
  DISPATCHED
  PARTIALLY_DISPATCHED
  FAILED
}

/**
 * Dispatch de um sinal mestre para uma licença.
 */
enum MasterSignalDispatchStatus {
  SKIPPED
  INSTRUCTION_CREATED
  FAILED
}

/**
 * Origem do sinal mestre.
 */
enum MasterSignalSource {
  MASTER_EA
  ADMIN_TEST
  SIMULATOR
}

enum OrderLogStatus {
  RECEIVED
  SENT
  EXECUTED
  REJECTED
  IGNORED
  CANCELLED
  ORDER_NOT_PLACED
  VOIDED_FALSE_EXECUTION
}

enum ExecutionStatus {
  FILLED
  PARTIAL
  REJECTED
  EXPIRED
  VOIDED
}

enum RiskEventType {
  DRAWDOWN_DAILY
  DRAWDOWN_MONTHLY
  LICENSE_SUSPENDED
  SLIPPAGE_EXCEEDED
  HEARTBEAT_TIMEOUT
  KILL_SWITCH
  INADIMPLENCIA
  VOLUME_CAP
  MARKET_HOURS
  OTHER
}

enum KillSwitchScope {
  GLOBAL
  LICENSE
  USER
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
  EA
}

enum TradeMode {
  DEMO
  REAL
}

enum RealTradingApprovalStatus {
  PENDING
  APPROVED
  SUSPENDED
  REVOKED
  BLOCKED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  BLOCKED
}

enum AdminPaymentStatus {
  PENDING
  CONFIRMED
  OVERDUE
}

enum RobotProductStatus {
  ACTIVE
  INACTIVE
}

enum RobotInstanceStatus {
  AWAITING_PAYMENT
  AWAITING_APPROVAL
  AWAITING_EA_ACTIVATION
  EA_ONLINE
  REAL_PENDING_VALIDATION
  OPERATIONAL_CONTROLLED
  SUSPENDED
  BLOCKED
}

enum AccountSnapshotType {
  PRE_MARKET
  PRE_TRADE
  POST_MARKET
  MANUAL
}

enum AccountSnapshotSource {
  EA
  ADMIN
  SYSTEM
}

enum RealTradePreflightStatus {
  PASSED
  FAILED
  BLOCKED
}

enum RealTradePreflightSource {
  INSTRUCTION
  DRY_RUN
  BULK_DISPATCH
}

enum RealManualBulkDispatchBatchStatus {
  PREVIEW_READY
  EXECUTING
  EXECUTED
  EXPIRED
  CANCELLED
  PARTIAL
}

enum RealManualBulkDispatchItemStatus {
  ELIGIBLE
  BLOCKED
  SELECTED
  DISPATCHED
  FAILED
  SKIPPED
  BLOCKED_AT_EXECUTE
}

enum InstructionOperationalMode {
  LIVE_MARKET
  AUTONOMOUS_STRATEGY
}

enum DailyFinancialRiskStatus {
  OK
  WARNING
  BLOCKED
}

enum AutonomousStrategyDecisionResult {
  ALLOWED
  BLOCKED
}

enum ProtectionMode {
  ATTACHED_SL_TP
  PENDING_PROTECTION_ORDERS
  UNKNOWN
}

enum ProtectionStatus {
  PROTECTION_CONFIRMED
  PROTECTION_FAILED
  PROTECTION_PENDING
  NOT_REQUIRED_FOR_DEBUG
  NOT_APPLICABLE
  SKIPPED_NO_POSITION
}

// ─── Auth (Auth.js adapter) + usuários ───────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  image         String?
  passwordHash  String?
  role          UserRole   @default(CLIENT)
  status        UserStatus @default(ACTIVE)
  blockedAt     DateTime?  @map("blocked_at")
  blockedByUserId String?  @map("blocked_by_user_id")
  inactiveAt    DateTime?  @map("inactive_at")
  inactiveByUserId String? @map("inactive_by_user_id")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts        Account[]
  sessions        Session[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  paymentAttempts PaymentAttempt[]
  licenses        License[]
  mt5Accounts     Mt5Account[]
  auditLogs              AuditLog[]              @relation("AuditLogActor")
  adminActions           AdminAction[]
  riskEvents             RiskEvent[]
  equitySnapshots        EquitySnapshot[]
  realTradingApprovals   RealTradingApproval[]
  accountSnapshots       AccountSnapshot[]
  realTradePreflights    RealTradePreflight[]
  termsAcceptances       TermsAcceptance[]
  robotInstances         RobotInstance[]
  billingCustomers       BillingCustomer[]
  bulkDispatchBatches    RealManualBulkDispatchBatch[]
  bulkDispatchItems      RealManualBulkDispatchItem[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Planos e billing ────────────────────────────────────────────────────────

model Plan {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?  @db.Text
  maxMt5Accounts Int      @default(1) @map("max_mt5_accounts")
  maxRobots      Int      @default(1) @map("max_robots")
  maxDevices     Int      @default(1) @map("max_devices")
  allowDemo      Boolean  @default(false) @map("allow_demo")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  prices        PlanPrice[]
  features      PlanFeature[]
  planProfiles  PlanExposureProfile[]
  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("plans")
}

model PlanPrice {
  id            String   @id @default(cuid())
  planId        String   @map("plan_id")
  currency      String   @default("BRL")
  amountCents   Int      @map("amount_cents")
  interval      String
  intervalCount Int      @default(1) @map("interval_count")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, isActive])
  @@map("plan_prices")
}

model PlanFeature {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_features")
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @map("user_id")
  planId                String             @map("plan_id")
  status                SubscriptionStatus @default(INCOMPLETE)
  gateway               String?
  gatewayCustomerId     String?            @map("gateway_customer_id")
  gatewaySubscriptionId String?            @map("gateway_subscription_id")
  currentPeriodStart    DateTime?          @map("current_period_start")
  currentPeriodEnd      DateTime?          @map("current_period_end")
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt           DateTime?          @map("cancelled_at")
  adminPaymentStatus    AdminPaymentStatus @default(PENDING) @map("admin_payment_status")
  robotCount            Int                @default(1) @map("robot_count")
  nextBillingAt         DateTime?          @map("next_billing_at")
  lastInvoiceId         String?            @unique @map("last_invoice_id")
  providerSubscriptionId String?           @map("provider_subscription_id")
  recurringEnabled      Boolean            @default(false) @map("recurring_enabled")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan            @relation(fields: [planId], references: [id])
  invoices       Invoice[]
  lastInvoice    Invoice?        @relation("SubscriptionLastInvoice", fields: [lastInvoiceId], references: [id], onDelete: SetNull)
  licenses       License[]
  robotInstances RobotInstance[]

  @@index([userId, status])
  @@index([planId])
  @@map("subscriptions")
}

model Invoice {
  id                 String          @id @default(cuid())
  userId             String          @map("user_id")
  subscriptionId     String          @map("subscription_id")
  planId             String          @map("plan_id")
  status             InvoiceStatus   @default(DRAFT)
  amountCents        Int             @map("amount_cents")
  currency           String          @default("BRL")
  description        String?         @db.Text
  provider           BillingProvider @default(MANUAL)
  providerInvoiceId  String?         @map("provider_invoice_id")
  gatewayInvoiceId   String?         @map("gateway_invoice_id")
  paymentUrl         String?         @map("payment_url")
  pixQrCodeUrl       String?         @map("pix_qr_code_url")
  pixCopyPaste       String?         @map("pix_copy_paste")
  metadataJson       Json?           @map("metadata_json")
  periodStart        DateTime?       @map("period_start")
  periodEnd          DateTime?       @map("period_end")
  dueAt              DateTime?       @map("due_at")
  paidAt             DateTime?       @map("paid_at")
  cancelledAt        DateTime?       @map("cancelled_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription      Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan              Plan                   @relation(fields: [planId], references: [id])
  subscriptionAsLast Subscription?         @relation("SubscriptionLastInvoice")
  payments          Payment[]
  paymentAttempts   PaymentAttempt[]
  providerEvents    PaymentProviderEvent[]

  @@index([subscriptionId, status])
  @@index([userId, status])
  @@index([planId])
  @@map("invoices")
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  invoiceId         String               @map("invoice_id")
  userId            String               @map("user_id")
  provider          BillingProvider      @default(MANUAL)
  method            PaymentMethod        @default(MANUAL)
  status            PaymentAttemptStatus @default(CREATED)
  amountCents       Int                  @map("amount_cents")
  providerPaymentId String?              @map("provider_payment_id")
  checkoutUrl       String?              @map("checkout_url")
  failureCode       String?              @map("failure_code")
  failureMessage    String?              @map("failure_message")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  invoice        Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerEvents PaymentProviderEvent[]

  @@unique([provider, providerPaymentId])
  @@index([invoiceId, status])
  @@index([userId])
  @@map("payment_attempts")
}

model PaymentProviderEvent {
  id               String           @id @default(cuid())
  provider         BillingProvider
  eventId          String           @map("event_id")
  eventType        String           @map("event_type")
  invoiceId        String?          @map("invoice_id")
  paymentAttemptId String?          @map("payment_attempt_id")
  rawJson          Json             @map("raw_json")
  idempotencyKey   String           @map("idempotency_key")
  processStatus    String           @default("pending") @map("process_status")
  processError     String?          @map("process_error")
  processedAt      DateTime?        @map("processed_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@unique([idempotencyKey])
  @@index([provider, eventType])
  @@map("payment_provider_events")
}

model BillingCustomer {
  id                 String          @id @default(cuid())
  userId             String          @map("user_id")
  provider           BillingProvider
  providerCustomerId String          @map("provider_customer_id")
  email              String
  name               String
  cpfCnpj            String?         @map("cpf_cnpj")
  phone              String?
  externalReference  String?         @map("external_reference")
  rawJson            Json?           @map("raw_json")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerCustomerId])
  @@unique([provider, userId])
  @@index([userId])
  @@map("billing_customers")
}

model Payment {
  id               String        @id @default(cuid())
  invoiceId        String        @map("invoice_id")
  status           PaymentStatus @default(PENDING)
  amountCents      Int           @map("amount_cents")
  currency         String        @default("BRL")
  gatewayPaymentId String?       @map("gateway_payment_id")
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  gateway     String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([gateway, eventId])
  @@index([gateway, eventType])
  @@map("webhook_events")
}

// ─── Perfis de exposição (camada comercial — sem estratégia) ─────────────────

model ExposureProfile {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  planProfiles    PlanExposureProfile[]
  licenseProfiles LicenseExposureProfile[]
  licenses        License[]

  @@map("exposure_profiles")
}

model PlanExposureProfile {
  planId            String @map("plan_id")
  exposureProfileId String @map("exposure_profile_id")

  plan            Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  exposureProfile ExposureProfile @relation(fields: [exposureProfileId], references: [id], onDelete: Cascade)

  @@id([planId, exposureProfileId])
  @@map("plan_exposure_profiles")
}

// ─── Licenciamento e MT5 ─────────────────────────────────────────────────────

model Mt5Account {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  login      String
  server     String
  brokerName String?  @map("broker_name")
  label      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenses License[]

  @@unique([login, server])
  @@index([userId])
  @@map("mt5_accounts")
}

model License {
  id                  String        @id @default(cuid())
  userId              String        @map("user_id")
  subscriptionId      String?       @map("subscription_id")
  mt5AccountId        String?       @map("mt5_account_id")
  exposureProfileId   String?       @map("exposure_profile_id")
  status              LicenseStatus @default(PENDING_ACTIVATION)
  haltNewEntries      Boolean       @default(false) @map("halt_new_entries")
  adminHaltNewEntries Boolean       @default(false) @map("admin_halt_new_entries")
  haltAllTrading      Boolean       @default(false) @map("halt_all_trading")
  activatedAt         DateTime?     @map("activated_at")
  suspendedAt         DateTime?     @map("suspended_at")
  revokedAt           DateTime?     @map("revoked_at")
  expectedTradeMode     TradeMode     @default(DEMO) @map("expected_trade_mode")
  expectedAccountLogin  String?       @map("expected_account_login")
  expectedAccountServer String?       @map("expected_account_server")
  expectedSymbol        String?       @map("expected_symbol")
  expectedMagicNumber   Int?          @map("expected_magic_number")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription           Subscription?            @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  mt5Account             Mt5Account?              @relation(fields: [mt5AccountId], references: [id], onDelete: SetNull)
  exposureProfile        ExposureProfile?         @relation(fields: [exposureProfileId], references: [id], onDelete: SetNull)
  devices                Device[]
  activationCodes        ActivationCode[]
  profileHistory         LicenseExposureProfile[]
  instructions           Instruction[]
  executions             Execution[]
  positionSnapshots      PositionSnapshot[]
  dailyPnls              DailyPnl[]
  riskEvents             RiskEvent[]
  killSwitchLogs         KillSwitchLog[]
  eaHeartbeats           EaHeartbeat[]
  eaErrorReports         EaErrorReport[]
  equitySnapshots        EquitySnapshot[]
  portfolioMetrics       PortfolioMetric[]
  masterSignalDispatches   MasterSignalDispatch[]
  realTradingApprovals     RealTradingApproval[]
  accountSnapshots         AccountSnapshot[]
  realTradePreflights      RealTradePreflight[]
  executionProtectionReports ExecutionProtectionReport[]
  robotInstances           RobotInstance[]
  dailyFinancialRiskLimits DailyFinancialRiskLimit[]
  dailyFinancialRiskStates DailyFinancialRiskState[]
  autonomousStrategyDecisions AutonomousStrategyDecision[]

  @@index([userId, status])
  @@index([mt5AccountId])
  @@index([subscriptionId])
  @@map("licenses")
}

model RobotProduct {
  id                        String             @id @default(cuid())
  slug                      String             @unique
  name                      String
  description               String?            @db.Text
  status                    RobotProductStatus @default(ACTIVE)
  monthlyPriceCents         Int                @map("monthly_price_cents")
  maxInstancesPerUser       Int                @default(1) @map("max_instances_per_user")
  isBlackBox                Boolean            @default(true) @map("is_black_box")
  sortOrder                 Int                @default(0) @map("sort_order")
  strategyCode              String?            @unique @map("strategy_code")
  strategyVersion           String             @default("1.0.0") @map("strategy_version")
  market                    String?
  defaultSymbol             String?            @map("default_symbol")
  requiresDailyFinancialStop Boolean           @default(true) @map("requires_daily_financial_stop")
  requiresRealTradingApproval Boolean         @default(true) @map("requires_real_trading_approval")
  requiresPreMarket         Boolean            @default(true) @map("requires_pre_market")
  requiresProtection        Boolean            @default(true) @map("requires_protection")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  instances RobotInstance[]

  @@map("robot_products")
}

model RobotInstance {
  id                         String              @id @default(cuid())
  userId                     String              @map("user_id")
  licenseId                  String?             @map("license_id")
  subscriptionId             String              @map("subscription_id")
  robotProductId             String              @map("robot_product_id")
  magicNumber                Int?                @map("magic_number")
  symbol                     String?
  autonomousStrategyCode     String?             @map("autonomous_strategy_code")
  autonomousStrategyEnabled  Boolean             @default(false) @map("autonomous_strategy_enabled")
  status                     RobotInstanceStatus @default(AWAITING_PAYMENT)
  createdAt                  DateTime            @default(now()) @map("created_at")
  activatedAt                DateTime?           @map("activated_at")
  suspendedAt                DateTime?           @map("suspended_at")
  blockedAt                  DateTime?           @map("blocked_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  license      License?     @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  robotProduct RobotProduct @relation(fields: [robotProductId], references: [id])

  @@unique([magicNumber])
  @@index([userId, status])
  @@index([subscriptionId])
  @@index([licenseId])
  @@map("robot_instances")
}

model LicenseExposureProfile {
  id                String   @id @default(cuid())
  licenseId         String   @map("license_id")
  exposureProfileId String   @map("exposure_profile_id")
  changedAt         DateTime @default(now()) @map("changed_at")
  changedByUserId   String?  @map("changed_by_user_id")

  license         License         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  exposureProfile ExposureProfile @relation(fields: [exposureProfileId], references: [id])

  @@index([licenseId, changedAt])
  @@map("license_exposure_profiles")
}

model Device {
  id              String       @id @default(cuid())
  licenseId       String       @map("license_id")
  deviceId        String       @map("device_id")
  fingerprint     String?
  eaVersion       String?      @map("ea_version")
  tokenHash       String       @map("token_hash")
  status          DeviceStatus @default(ACTIVE)
  lastSeenAt      DateTime?    @map("last_seen_at")
  rotateAfter     DateTime?    @map("rotate_after")
  revokedAt       DateTime?    @map("revoked_at")
  revokedByUserId String?      @map("revoked_by_user_id")
  blockedAt       DateTime?    @map("blocked_at")
  blockedByUserId String?      @map("blocked_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, deviceId])
  @@index([licenseId, status])
  @@map("devices")
}

model ActivationCode {
  id        String    @id @default(cuid())
  licenseId String    @map("license_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

