  dailyLossLimitCents Int      @map("daily_loss_limit_cents")
  includeOpenPnL      Boolean  @default(true) @map("include_open_pnl")
  resetTimezone       String   @default("America/Sao_Paulo") @map("reset_timezone")
  resetAtTime         String   @default("00:00") @map("reset_at_time")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, accountLogin, accountServer, strategyCode, symbol])
  @@index([licenseId])
  @@map("daily_financial_risk_limits")
}

model DailyFinancialRiskState {
  id                  String                   @id @default(cuid())
  licenseId           String                   @map("license_id")
  accountLogin        String                   @map("account_login")
  accountServer       String                   @map("account_server")
  strategyCode        String                   @map("strategy_code")
  symbol              String
  tradeDate           String                   @map("trade_date")
  realizedPnlCents    Int                      @default(0) @map("realized_pnl_cents")
  openPnlCents        Int                      @default(0) @map("open_pnl_cents")
  totalPnlCents       Int                      @default(0) @map("total_pnl_cents")
  limitCents          Int                      @default(0) @map("limit_cents")
  remainingLossCents  Int                      @default(0) @map("remaining_loss_cents")
  status              DailyFinancialRiskStatus @default(OK)
  lastUpdatedAt       DateTime                 @map("last_updated_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, accountLogin, accountServer, strategyCode, symbol, tradeDate])
  @@index([licenseId, tradeDate])
  @@map("daily_financial_risk_states")
}

model AutonomousStrategyDecision {
  id                      String                           @id @default(cuid())
  licenseId               String                           @map("license_id")
  deviceId                String                           @map("device_id")
  userId                  String                           @map("user_id")
  strategyCode            String                           @map("strategy_code")
  strategyVersion         String                           @map("strategy_version")
  accountLogin            String                           @map("account_login")
  accountServer           String                           @map("account_server")
  symbol                  String
  magicNumber             Int                              @map("magic_number")
  side                    InstructionSide
  orderType               InstructionOrderType             @map("order_type")
  orderPrice              Decimal?                         @map("order_price") @db.Decimal(18, 6)
  requestedContracts      Int                              @map("requested_contracts")
  plannedManagementPlan   Json                             @map("planned_management_plan")
  approvedManagementPlan  Json?                            @map("approved_management_plan")
  decision                AutonomousStrategyDecisionResult
  reasonCode              String?                          @map("reason_code")
  detail                  String?                          @db.Text
  signalReason            String?                          @map("signal_reason")
  dailyRiskSnapshot       Json?                            @map("daily_risk_snapshot")
  instructionId           String?                          @unique @map("instruction_id")
  riskSessionId           String?                          @map("risk_session_id")
  createdAt               DateTime                         @default(now()) @map("created_at")

  license     License      @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  instruction Instruction? @relation(fields: [instructionId], references: [id], onDelete: SetNull)

  @@index([licenseId, createdAt])
  @@index([strategyCode, createdAt])
  @@index([decision, createdAt])
  @@map("autonomous_strategy_decisions")
}
