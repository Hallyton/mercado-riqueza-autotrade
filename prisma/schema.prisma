  symbol         String
  side           InstructionSide
  orderType      InstructionOrderType @map("order_type")
  orderPrice     Decimal?             @map("order_price") @db.Decimal(18, 6)
  quantity       Decimal              @db.Decimal(18, 6)
  stopLoss       Decimal?             @map("stop_loss") @db.Decimal(18, 6)
  takeProfit     Decimal?             @map("take_profit") @db.Decimal(18, 6)
  idempotencyKey String               @unique @map("idempotency_key")
  requestId      String?              @map("request_id")
  expiresAt      DateTime             @map("expires_at")
  source                         InstructionSource? @map("source")
  currentStatus                  OrderLogStatus     @default(RECEIVED) @map("current_status")
  magicNumber                    Int?               @map("magic_number")
  accountLogin                   String?            @map("account_login")
  accountServer                  String?            @map("account_server")
  requiresProtectionConfirmation Boolean            @default(false) @map("requires_protection_confirmation")
  protectionBlocked              Boolean            @default(false) @map("protection_blocked")
  managementPlan                 Json?              @map("management_plan")
  bulkBatchId                    String?            @map("bulk_batch_id")
  operationalMode                InstructionOperationalMode? @map("operational_mode")
  createdAt                      DateTime           @default(now()) @map("created_at")
  updatedAt                      DateTime           @updatedAt @map("updated_at")

  license                      License                       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  bulkBatch                    RealManualBulkDispatchBatch?  @relation(fields: [bulkBatchId], references: [id], onDelete: SetNull)
  autonomousStrategyDecision   AutonomousStrategyDecision?
  statusLogs                   InstructionStatusLog[]
  executions                   Execution[]
  masterSignalDispatch         MasterSignalDispatch?
  realTradePreflights          RealTradePreflight[]
  executionProtectionReports   ExecutionProtectionReport[]

  @@index([licenseId, currentStatus, createdAt])
  @@index([licenseId, magicNumber])
  @@index([bulkBatchId])
  @@map("instructions")
}

model InstructionStatusLog {
  id            String         @id @default(cuid())
