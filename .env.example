# PostgreSQL (obrigatório para migrate e seed; obrigatório em NODE_ENV=production)
DATABASE_URL="postgresql://user:password@localhost:5432/mercado_da_riqueza_autotrade?schema=public"

# Auth.js — gere com: openssl rand -base64 32 (obrigatório em produção; não use o placeholder)
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Webhook billing — header x-webhook-secret ou x-billing-webhook-secret
# OBRIGATÓRIO em NODE_ENV=production: sem valor válido o servidor não sobe (instrumentation)
# e POST /api/webhooks/billing retorna 503. Em desenvolvimento, omitir permite testes locais.
BILLING_WEBHOOK_SECRET="replace-with-webhook-secret"

# Seed — usuário admin inicial (obrigatório no primeiro seed)
ADMIN_EMAIL="admin@mercadodariqueza.com.br"
ADMIN_PASSWORD="change-me-in-production"
ADMIN_NAME="Administrador"
